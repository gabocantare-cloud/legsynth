__pycache__/
*.py[cod]
.venv/
env/
.env
*.egg-info/
.pytest_cache/
papers/

# Generated results. Two things a reviewer should get without a 20-minute run are
# kept: the JSON the published numbers are quoted from, and the CAD deliverables.
# Everything else regenerates.
results/*
!results/*.json
!results/cad/
# The audit's own evidence ships with the repo: results/audit/ holds campaigns run
# by the pre-publication audit to settle a contested claim, and a reader who cannot
# see them cannot check the finding. Un-ignoring the directory is what lets git
# descend into it - a `!` on the files alone cannot rescue them from an excluded
# parent.
!results/audit/

# --quick is a smoke test. Its outputs are never the published ones, so they
# never get committed.
results/*quick*
results/cad/*quick*
